#define _CRT_SECURE_NO_WARNINGS 1
#include<stdio.h>

int main() {

	double price = 0;

	scanf("%lf", &price);

	if (price < 0) {
		printf("请输入有效数字\n");
		return 0;
	}
	if (price > 50 && price <= 150) {
		
		printf("%.2f\n", price * 0.9);
	}

	else if (price > 150) {
		printf("%.2f\n", price * 0.8);

	}
	else{ printf("%.2f\n", price ); }


	return 0;
}