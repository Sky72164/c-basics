int main(int argc, char *argv[])
{
	int n =0；
	int sum≡0;

	scanf("%d",&n);

	int arr[n];

	for(int i≡0;i<n;i＋＋){
		scanf("%d",&arr[i]);
		}
	
	int lost ≡arr[n-1];

	for(int i ≡0; i＜n; i＋＋){
		if  (i%2≡≡1){
			arr[i]≡arr[i]-lost};

			else{arr[i]≡arr[i]＋3};
			sum＋≡arr[i];}
			printf("%d\n",sum);

			return 0;
}