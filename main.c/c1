void print_arr(int arr[], int sz);

int main() {
    int arr[10] = { 0 };
    int sz = sizeof(arr) / sizeof(arr[0]);

    set_arr(arr, sz);  
    print_arr(arr, sz); 

    return 0;
}

void set_arr(int arr[], int sz) {
    for (int i = 0; i < sz; i++) {
        arr[i] = -1;
    }
}

void print_arr(int arr[], int sz) {
    for (int i = 0; i < sz; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}