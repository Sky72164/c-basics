#define _CRT_SECURE_NO_WARNINGS 1
#include<stdio.h>

int main() {
	double sum = 0;
	double v = 0;
	double arr[10];
	double s = 0;
	
		for (int i = 0;i < 10;i++)
		{   
			scanf("%lf", &arr[i]);
			sum += arr[i];
			
		}
		v = sum / 10.0;

		for (int i = 0;i < 10;i++){
			if (arr[i] >= v) { s += arr[i]; }
			
		}
	     
		printf("%f %f\n", v,s);
		
			return 0;
	    
}
